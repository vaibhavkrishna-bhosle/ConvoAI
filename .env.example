# Copy to .env and adjust. All values are optional.

# Flask session signing key. If unset, one is generated in data/.secret_key
# SECRET_KEY=

# Sign-in is off by default: the app opens directly as the built-in local admin.
# Set to 1 to require accounts (and per-department collection access).
LOGIN_REQUIRED=0

# The built-in account. ADMIN_NAME is the name the assistant greets you with.
# With sign-in on and ADMIN_PASSWORD unset, a random password is generated and
# written to data/admin_credentials.txt
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@convoai.local
# ADMIN_PASSWORD=

# Local LLM server
# Use 127.0.0.1 rather than localhost (avoids a ~2 s IPv6 lookup delay on Windows)
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text
